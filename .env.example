# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Free key: https://console.groq.com/keys  (used as automatic fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Which provider to try first: gemini | groq
PRIMARY_PROVIDER=gemini

# PostgreSQL for persistent memory (free on Render/Railway)
# Local: postgresql://localhost:5432/nova
# Render: paste the External Database URL from your dashboard
DATABASE_URL=postgresql://localhost:5432/nova
