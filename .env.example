# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Free key: https://console.groq.com/keys  (used as automatic fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Which provider to try first: gemini | groq
PRIMARY_PROVIDER=gemini

# PostgreSQL (OPTIONAL — leave empty for in-memory mode)
# Local: postgresql://localhost:5432/nova
# Supabase (free): postgresql://xxx@xxx.supabase.co:5432/postgres
# If empty, N.O.V.A uses in-memory mode (conversations reset on restart)
DATABASE_URL=
